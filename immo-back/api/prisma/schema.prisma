// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  fullName    String?
  email       String?      @unique
  phone       String?
  country     String       @default("FR")
  tz          String       @default("Africa/Casablanca")
  twofa       TwoFA?
  bank        Bank?
  prefs       Preferences?
  sessions    Session[]
  apiKeys     ApiKey[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  WebhookConf WebhookConf?
  Kyc         Kyc?
}

model TwoFA {
  id      String  @id @default(cuid())
  enabled Boolean @default(false)
  secret  String  @default("")
  user    User    @relation(fields: [userId], references: [id])
  userId  String  @unique
}

model Bank {
  id     String @id @default(cuid())
  iban   String
  bic    String
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Preferences {
  id       String  @id @default(cuid())
  theme    String  @default("light")
  lang     String  @default("fr")
  currency String  @default("EUR")
  beta     Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id])
  userId   String  @unique
}

model ApiKey {
  id        String   @id @default(cuid())
  label     String
  last4     String
  hash      String // SHA-256 du plaintext
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model WebhookConf {
  id     String @id @default(cuid())
  url    String
  secret String
  events String // JSON stringifié
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Kyc {
  id     String @id @default(cuid())
  status String @default("none")
  first  String
  last   String
  doc    String
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Session {
  id       String   @id @default(cuid())
  agent    String
  ip       String
  lastSeen DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
}
model Transaction {
  id          Int      @id @default(autoincrement())
  userId      String?
  stripeId    String   @unique
  amount      Int
  currency    String
  status      String
  createdAt   DateTime @default(now())
}
model BillingProfile {
  id        Int      @id @default(autoincrement())
  userId    String?  // si tu as un user
  fullName  String?
  email     String?
  phone     String?
  country   String?
  city      String?
  address   String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits  FiatDeposit[]
}

enum FiatMethod {
  SEPA
  CARD
}

enum FiatStatus {
  PENDING      // créé côté app
  SUBMITTED    // user a cliqué "Enregistrer mon virement"
  PROCESSING   // en traitement back-office
  SUCCEEDED    // crédité
  FAILED
}

model FiatDeposit {
  id           Int        @id @default(autoincrement())
  userId       String?
  method       FiatMethod
  currency     String
  amountMinor  Int        // cents
  status       FiatStatus @default(PENDING)
  reference    String     // "0xbda5...197e" etc.
  iban         String
  bic          String
  holder       String
  epcText      String?    // payload EPC texte
  receiptPath  String?    // justificatif uploadé
  stripePiId   String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  billingProfileId Int?
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id])
}
