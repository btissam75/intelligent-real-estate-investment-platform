{
  "compilerOptions": {
      "baseUrl": ".",                    // 👈 important
    "paths": { "@/*": ["src/*"] },     // 👈 alias TS
    
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "src/auth","src/types"]
}

